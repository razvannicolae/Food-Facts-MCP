USDA_FDC_API_KEY=

# FatSecret Platform API (https://platform.fatsecret.com)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Cache settings (all optional)
CACHE_DB_PATH=        # default: ~/.cache/food_facts_mcp/food_facts.db
CACHE_TTL_DAYS=       # default: no expiry (food data is stable)
CACHE_ENABLED=true    # set false to disable caching entirely
